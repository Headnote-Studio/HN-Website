# Headnote Studio .htaccess Configuration
# Place this file in the website's root directory (public_html).

# ── Security Headers ──
<IfModule mod_headers.c>
    # Prevent clickjacking
    Header always append X-Frame-Options SAMEORIGIN
    # Enable XSS protection
    Header set X-XSS-Protection "1; mode=block"
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options nosniff
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # HSTS — force HTTPS for 1 year (no preload, reversible if needed)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# ── HTTPS + canonical host ──
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Redirect HTTP to HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Redirect www to non-www
    RewriteCond %{HTTP_HOST} ^www\.headnotestudio\.com [NC]
    RewriteRule ^(.*)$ https://headnotestudio.com/$1 [L,R=301]

    # Catch-all: redirect any extensionless URL to its .html counterpart if that file exists
    # Handles /services, /about, /contact, /privacy, /terms without per-page rules.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.html -f
    RewriteRule ^(.+)$ /$1.html [R=301,L]
</IfModule>

# ── Custom Error Pages ──
ErrorDocument 404 /404.html
ErrorDocument 500 /404.html

# ── Cache Control ──
<IfModule mod_expires.c>
    ExpiresActive On

    # Images — 1 month
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"

    # CSS and JavaScript — 1 month
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"

    # Fonts — 1 year
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # HTML — 1 hour
    ExpiresByType text/html "access plus 1 hour"

    # PDFs — 1 month
    ExpiresByType application/pdf "access plus 1 month"
</IfModule>

# ── Compression ──
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
</IfModule>

# ── Remove trailing slashes (except real directories) ──
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [R=301,L]
</IfModule>

# ── Block access to dotfiles ──
<Files ~ "^\.">
    Order allow,deny
    Deny from all
</Files>

# ── Block access to backup/config files ──
<FilesMatch "\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|swp)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Prevent indexing of non-public files ──
<IfModule mod_headers.c>
    <FilesMatch "\.(bak|config|dist|fla|inc|ini|log|psd|sh|sql|swp|md)$">
        Header set X-Robots-Tag "noindex, nofollow"
    </FilesMatch>
</IfModule>

# ── Prevent hotlinking of images ──
<IfModule mod_rewrite.c>
    RewriteCond %{HTTP_REFERER} !^$
    RewriteCond %{HTTP_REFERER} !^https?://(www\.)?headnotestudio\.com [NC]
    RewriteRule \.(gif|jpe?g|png|svg)$ - [F,L]
</IfModule>

# ── UTF-8 + MIME types ──
AddDefaultCharset UTF-8
<IfModule mod_mime.c>
    AddCharset UTF-8 .txt .md .html .css .js .json .xml
    AddType application/font-woff woff
    AddType application/font-woff2 woff2
    AddType image/svg+xml svg svgz
    AddType application/javascript js
    AddType application/manifest+json webmanifest
</IfModule>
